#!/usr/bin/env bash
# Installed on the server as /usr/local/bin/dokudocs-deploy, owned by root. The
# GitHub runner's user may run only this, through sudo (docs/deployment.md).
# It checks out a commit that is on origin/main and hands over to that
# commit's scripts/deploy/deploy.sh. The registry token comes on stdin.
#
#   echo "$TOKEN" | sudo dokudocs-deploy <40-character commit SHA>
set -euo pipefail

sha=${1:-}
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: dokudocs-deploy <40-character commit SHA>" >&2
  exit 2
fi

cd /opt/dokudocs
git fetch --quiet origin main
# Only what was merged to main is deployed, whoever asks.
if ! git merge-base --is-ancestor "$sha" origin/main; then
  echo "$sha is not on origin/main" >&2
  exit 1
fi
git checkout --quiet --detach "$sha"
exec scripts/deploy/deploy.sh "$sha"
