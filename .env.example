# Copy to .env next to docker-compose.yaml and fill in. Compose reads it on its own.
# The development stack (docker-compose.dev.yaml) has defaults for everything,
# so there only the lines you want to change are needed.

# true adds logs, metrics and traces to Grafana Cloud to `make dev` and
# `make build` (docs/observability.md); the three GRAFANA_CLOUD_* values at the
# end are then required.
OBSERVABILITY=false

# Required for the production stack. Left empty, development uses its defaults.
# The site's public address, e.g. https://docs.example.com
PUBLIC_APP_URL=
# Generate each secret separately with: openssl rand -hex 32
# Use a hex password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
COLLAB_SERVICE_SECRET=

# Optional; the values shown are the defaults.
POSTGRES_DB=dokudocs
POSTGRES_USER=postgres
# The site is served on 127.0.0.1 at this port.
FRONTEND_PORT=8088
ACCESS_TOKEN_TTL=24h
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Requests a minute one client may make to sign-in endpoints; 0 turns a limit off.
# The counters live in the API process, so they hold for one API instance.
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_GOOGLE_START_PER_MIN=20
RATE_LIMIT_GOOGLE_CALLBACK_PER_MIN=30

# Outgoing email (verification links). Port 587 with STARTTLS; port 465 is not
# supported. Leave SMTP_HOST empty to send nothing. In development, make dev
# starts Mailpit and fills these in: read the mail at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true closes the app to a User whose email is not verified. The API refuses to
# start with it on and no SMTP_HOST and SMTP_FROM.
REQUIRE_EMAIL_VERIFICATION=false

# Optional: AI answers and search over documents.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MODEL=gpt-5-mini
RAG_REQUEST_TIMEOUT=120s

# Observability, used when OBSERVABILITY=true.
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
