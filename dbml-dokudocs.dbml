// =======================================================
//  DOKUDOCS - PRODUCTION DATABASE SCHEMA (DBML)
//  Best Practice: 3NF Normalized RBAC + OAuth + Sessions
// =======================================================

// -------------------------------------------------------
// 1. ENUMS & TYPE DEFINITIONS
// -------------------------------------------------------
Enum workspace_role {
  owner
  admin
  member
  guest
}

Enum project_visibility {
  workspace
  private
}

Enum project_member_role {
  manager
  editor
  viewer
}

Enum document_type {
  markdown
  dbdiagram
  mermaid
}

Enum document_visibility {
  inherit
  workspace
  private
  public_link
}

Enum document_access_level {
  owner
  edit
  comment
  view
}

// -------------------------------------------------------
// 2. AUTHENTICATION, USERS & RBAC
// -------------------------------------------------------
Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  account_no varchar(64) [unique, not null]
  email varchar(255) [unique, not null]
  email_verified_at timestamptz [note: 'Waktu verifikasi email, otomatis terisi jika via verified OAuth provider']
  password_hash varchar(255) [note: 'Nullable jika registrasi via OAuth']
  full_name varchar(100) [not null]
  phone_number varchar(30) [note: 'Nomor telepon pemulihan akun dari form /account']
  bio text [note: 'Bio profil pengguna dari form /account & /settings/profile']
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [name: 'idx_users_email']
  }
}

Table user_settings {
  user_id uuid [pk, ref: - users.id]
  theme varchar(20) [not null, default: 'system', note: 'light, dark, system']
  font_family varchar(50) [not null, default: 'inter']
  direction varchar(10) [not null, default: 'ltr', note: 'ltr, rtl']
  language varchar(10) [not null, default: 'en', note: 'Pengaturan bahasa UI dari form /settings/account']
  notification_prefs jsonb [not null, default: `'{"email": true, "in_app": true}'`]
  editor_prefs jsonb [not null, default: `'{"view_mode": "split", "split_percent": 50, "is_live_render": true, "sync_scroll": true, "show_outline": false, "preview_mode": "view"}'`, note: 'Sinkronisasi preferensi editor antar-perangkat']
  updated_at timestamptz [not null, default: `now()`]
}

// Master Role Platform (Superadmin, Admin, Member, Support, dll)
Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [not null]
  slug varchar(50) [unique, not null, note: 'superadmin, admin, member, support']
  description text
  is_system boolean [not null, default: false, note: 'Jika true, role bawaan sistem tidak boleh dihapus']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [name: 'idx_roles_slug']
  }
}

// Junction Table: User - Role Mapping (1NF Compliant + Audit Trail)
Table user_roles {
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by uuid [ref: > users.id, note: 'Admin yang memberikan role']

  indexes {
    (user_id, role_id) [pk]
    role_id [name: 'idx_user_roles_role']
  }
}

// Integrasi Akun OAuth Pihak Ketiga (Google, GitHub, GitLab, dll)
Table oauth_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  provider varchar(50) [not null, note: 'google, github, gitlab, etc.']
  provider_user_id varchar(255) [not null, note: 'Unique ID dari provider (cth: Google sub, GitHub ID)']
  provider_email varchar(255) [note: 'Email yang dilaporkan dari provider']
  
  // OAuth Tokens (Disimpan untuk integrasi API pihak ketiga seperti Git Sync / Import)
  access_token text
  refresh_token text
  token_expires_at timestamptz
  scope text

  // Metadata Profil Mentah
  raw_profile jsonb [note: 'Payload mentah profil OAuth']
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_user_id) [unique, name: 'idx_oauth_provider_user']
    (user_id, provider) [unique, name: 'idx_oauth_user_provider']
    user_id [name: 'idx_oauth_accounts_user']
  }
}

// Manajemen Sesi Multi-Device & Revoke Token
Table user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  session_token varchar(255) [unique, not null, note: 'Opaque token atau hash refresh token']
  ip_address varchar(45) [note: 'Mendukung format IPv4 & IPv6']
  user_agent text
  device_name varchar(100) [note: 'Cth: Chrome di macOS']
  is_revoked boolean [not null, default: false]
  last_active_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    session_token [name: 'idx_user_sessions_token']
    user_id [name: 'idx_user_sessions_user']
    expires_at [name: 'idx_user_sessions_expires']
  }
}

// -------------------------------------------------------
// 3. WORKSPACE & TENANT ISOLATION (LEVEL 1 PERMISSION)
// -------------------------------------------------------
Table workspaces {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  plan varchar(50) [not null, default: 'Free', note: 'Free, Pro Workspace, Enterprise']
  logo_url text
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [name: 'idx_workspaces_slug']
  }
}

Table workspace_members {
  workspace_id uuid [not null, ref: > workspaces.id]
  user_id uuid [not null, ref: > users.id]
  role workspace_role [not null, default: 'member']
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, user_id) [pk]
    user_id [name: 'idx_workspace_members_user']
  }
}

Table workspace_invites {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id]
  email varchar(255) [not null]
  role workspace_role [not null, default: 'member']
  token varchar(64) [unique, not null]
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
}

// -------------------------------------------------------
// 4. PROJECTS & CATEGORIES (LEVEL 2 PERMISSION)
// -------------------------------------------------------
Table projects {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id]
  name varchar(255) [not null]
  description text
  logo_url text
  color_badge varchar(50) [default: '#3b82f6']
  visibility project_visibility [not null, default: 'workspace']
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    workspace_id [name: 'idx_projects_workspace']
  }
}

Table project_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id]
  name varchar(100) [not null]
  color_id varchar(50) [not null, default: 'blue', note: 'blue, emerald, purple, etc']
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, name) [unique]
    (project_id, sort_order) [name: 'idx_project_categories_order']
  }
}

Table project_members {
  project_id uuid [not null, ref: > projects.id]
  user_id uuid [not null, ref: > users.id]
  role project_member_role [not null, default: 'editor']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, user_id) [pk]
  }
}

Table project_stars {
  user_id uuid [not null, ref: > users.id]
  project_id uuid [not null, ref: > projects.id]
  starred_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, project_id) [pk]
  }
}

// -------------------------------------------------------
// 5. DOCUMENTS & PERMISSIONS (LEVEL 3 PERMISSION)
// -------------------------------------------------------
Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id]
  project_id uuid [ref: > projects.id, note: 'Null jika standalone doc / draft']
  title varchar(255) [not null, default: 'Untitled Document']
  type document_type [not null]
  content text [not null, default: '']
  author_id uuid [not null, ref: > users.id]
  tags text[] [not null, default: `'{}'`]

  // Status & Visibilitas
  is_draft boolean [not null, default: false, note: 'Draft hanya muncul di My Drafts author']
  visibility document_visibility [not null, default: 'inherit']
  share_token varchar(64) [unique, note: 'Token untuk Public Share link']

  // Visual Thumbnails (SVG disimpan langsung di DB)
  thumbnail text [note: 'Raw SVG Light string']
  thumbnail_dark text [note: 'Raw SVG Dark string']
  thumbnail_preview text [note: 'Raw SVG Preview Light string']
  thumbnail_preview_dark text [note: 'Raw SVG Preview Dark string']

  // Timestamps & Soft Delete (30 Days Retention)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Jika terisi, masuk ke Trash']
  deleted_by uuid [ref: > users.id]

  indexes {
    workspace_id [name: 'idx_docs_workspace']
    project_id [name: 'idx_docs_project']
    (workspace_id, author_id) [name: 'idx_docs_author_draft']
    share_token [name: 'idx_docs_share_token']
  }
}

// Junction Table: Multi-Category Support (Many-to-Many)
Table document_category_mappings {
  document_id uuid [not null, ref: > documents.id]
  category_id uuid [not null, ref: > project_categories.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, category_id) [pk]
    category_id [name: 'idx_doc_cat_category']
  }
}

Table document_accesses {
  document_id uuid [not null, ref: > documents.id]
  user_id uuid [not null, ref: > users.id]
  access_level document_access_level [not null, default: 'view']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, user_id) [pk]
  }
}

Table document_stars {
  user_id uuid [not null, ref: > users.id]
  document_id uuid [not null, ref: > documents.id]
  starred_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, document_id) [pk]
  }
}

Table document_views {
  user_id uuid [not null, ref: > users.id]
  document_id uuid [not null, ref: > documents.id]
  last_viewed_at timestamptz [not null, default: `now()`]
  view_count int [not null, default: 1]

  indexes {
    (user_id, document_id) [pk]
    (user_id, last_viewed_at) [name: 'idx_doc_views_recent']
  }
}

// -------------------------------------------------------
// 6. COMMENTS, REPLIES & DISCUSSIONS
// -------------------------------------------------------
Table comment_threads {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > documents.id]
  author_id uuid [not null, ref: > users.id]
  
  // Anchor Posisi Teks / Block Muya Editor
  selected_text text [not null]
  block_id varchar(100)
  from_pos int
  to_pos int
  block_path jsonb
  section_title varchar(255)

  content text [not null]
  is_resolved boolean [not null, default: false]
  resolved_at timestamptz
  resolved_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, is_resolved) [name: 'idx_comment_threads_doc']
  }
}

Table comment_replies {
  id uuid [pk, default: `gen_random_uuid()`]
  thread_id uuid [not null, ref: > comment_threads.id]
  author_id uuid [not null, ref: > users.id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    thread_id [name: 'idx_comment_replies_thread']
  }
}

// -------------------------------------------------------
// 7. VERSION HISTORY & REVISIONS
// -------------------------------------------------------
Table document_revisions {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > documents.id]
  author_id uuid [not null, ref: > users.id]
  version_number int [not null]
  title varchar(255) [null]
  content text [not null]
  is_named boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, version_number) [unique]
    (document_id, version_number) [name: 'idx_doc_revisions_history']
  }
}

// -------------------------------------------------------
// 8. TABLE GROUPS (FOR CLEAN VISUALIZATION IN CANVAS)
// -------------------------------------------------------
TableGroup Authentication_Users [color: #3b82f6] {
  users
  user_settings
  roles
  user_roles
  oauth_accounts
  user_sessions
}

TableGroup Workspaces_Tenancy [color: #8b5cf6] {
  workspaces
  workspace_members
  workspace_invites
}

TableGroup Projects_Categories [color: #10b981] {
  projects
  project_categories
  project_members
  project_stars
}

TableGroup Documents_Access [color: #f59e0b] {
  documents
  document_category_mappings
  document_accesses
  document_stars
  document_views
  document_revisions
}

TableGroup Comments_Collaboration [color: #ec4899] {
  comment_threads
  comment_replies
}