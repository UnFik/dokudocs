# Copy to .env next to docker-compose.yaml and fill in. Compose reads it on its own.
# The development stack (docker-compose.dev.yaml) has defaults for everything,
# so there only the lines you want to change are needed.

# Required for the production stack.
PUBLIC_APP_URL=https://docs.example.com
# Generate each secret separately with: openssl rand -hex 32
# Use a hex password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
COLLAB_SERVICE_SECRET=

# Optional; the values shown are the defaults.
POSTGRES_DB=dokudocs
POSTGRES_USER=postgres
# The site is served on 127.0.0.1 at this port.
FRONTEND_PORT=8088
ACCESS_TOKEN_TTL=24h
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI answers and search over documents.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MODEL=gpt-5-mini
RAG_REQUEST_TIMEOUT=120s

# Optional: logs, metrics and traces to Grafana Cloud (docs/observability.md).
# On: uncomment COMPOSE_FILE for your stack and the three values below.
# Off: leave COMPOSE_FILE commented (or list only the base file).
# COMPOSE_FILE=docker-compose.yaml:docker-compose.observability.yaml
# COMPOSE_FILE=docker-compose.dev.yaml:docker-compose.observability.yaml
# GRAFANA_CLOUD_OTLP_URL=https://otlp-gateway-prod-XX.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_KEY=
